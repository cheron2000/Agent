# Local Windows Desktop Agent settings
# Copy to .env and adjust values for your machine.
# Keep the server bound to localhost unless remote access is explicitly secured.

AGENT_HOST=127.0.0.1
AGENT_PORT=8765
# Optional override. By default, the client URL follows AGENT_PORT.
# AGENT_BASE_URL=http://127.0.0.1:8765

# Additional accepted Host header values; localhost defaults are always retained.
ALLOWED_HOSTS=

# Optional comma-separated CORS origins. If omitted, localhost origins use AGENT_PORT.
# CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# Optional. If blank/unset, a local .agent_token is generated.
# Never commit a real token.
AGENT_AUTH_TOKEN=
